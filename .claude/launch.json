{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "frontend"
    },
    {
      "name": "api",
      "runtimeExecutable": "venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000,
      "cwd": "api"
    }
  ]
}
