# SECRETOS: nunca dentro de la imagen.
# credenciales.json es una clave privada de service account y .env tiene la key
# de Gemini. Si entran al contenedor quedan embebidos en la imagen y cualquiera
# que la baje los tiene. En Cloud Run se inyectan como variables de entorno
# (GCP_SA_KEY y GEMINI_API_KEY); main.py ya prefiere la variable sobre el archivo.
credenciales.json
.env
*.env

# El entorno virtual local: pesa cientos de MB y ademas trae binarios de Windows
# que no sirven en la imagen de Linux.
venv/

__pycache__/
*.pyc
